Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Fixed Frame: map
    Frame Rate: 20
    Background Color: 40; 40; 40
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: EVALUATION - truth comparison and scores
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 100
  - Class: rviz_default_plugins/TF
    Name: Sensor frames
    Enabled: true
  - Class: rviz_default_plugins/PointCloud2
    Name: LiDAR
    Enabled: true
    Topic:
      Value: /sensors/lidar/points
      Reliability Policy: Best Effort
      History Policy: Keep Last
      Depth: 2
    Size (Pixels): 2
    Style: Points
    Color Transformer: AxisColor
    Axis: Z
  - Class: rviz_default_plugins/MarkerArray
    Name: Truth boxes (green)
    Enabled: true
    Topic:
      Value: /ground_truth/markers
  - Class: rviz_default_plugins/MarkerArray
    Name: Algorithm boxes (orange)
    Enabled: true
    Topic:
      Value: /perception/markers
  - Class: rviz_default_plugins/MarkerArray
    Name: True boundaries
    Enabled: true
    Topic:
      Value: /ground_truth/boundary_markers
  - Class: rviz_default_plugins/MarkerArray
    Name: Algorithm boundaries
    Enabled: true
    Topic:
      Value: /perception/boundary_markers
  - Class: rviz_default_plugins/Image
    Name: Front camera
    Enabled: true
    Topic:
      Value: /sensors/front_camera/image_raw
      Reliability Policy: Best Effort
      Depth: 2
  - Class: rviz_default_plugins/Marker
    Name: LIVE SCORE - F1 and frame status
    Enabled: true
    Topic:
      Value: /evaluation/score_marker
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 65
      Pitch: 1.1
      Yaw: 0.7
      Focal Point: &id001
        X: 15
        Y: 17
        Z: 0
      Name: Free Orbit - drag to rotate
      Target Frame: <Fixed Frame>
    Saved:
    - Class: rviz_default_plugins/Orbit
      Name: Reset view
      Distance: 65
      Pitch: 1.1
      Yaw: 0.7
      Focal Point: *id001
      Target Frame: <Fixed Frame>
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
Window Geometry:
  Width: 1500
  Height: 950
  X: 400
  Y: 100
