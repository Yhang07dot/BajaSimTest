<?xml version="1.0"?>
<package format="3">
  <name>baja_perception_sim</name><version>0.1.0</version>
  <description>Gazebo Harmonic perception test track and ROS 2 evaluation tools.</description>
  <maintainer email="maintainer@example.com">Baja simulation team</maintainer><license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend><depend>sensor_msgs</depend><depend>geometry_msgs</depend>
